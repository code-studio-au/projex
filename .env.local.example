# Local development baseline.
# Copy to `.env.local` for normal local app + local-services usage.

DATABASE_URL=postgres://projex:projex@localhost:5432/projex

BETTER_AUTH_SECRET=replace-with-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173
PROJEX_APP_BASE_URL=http://localhost:3000
PROJEX_AUTH_RESET_REDIRECT_URL=http://localhost:3000/reset-password
PROJEX_AUTH_EMAIL_CHANGE_REDIRECT_URL=http://localhost:3000/verify-email-change

# Optional invite/reset-password delivery
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
RESEND_FROM=
PROJEX_AUTH_EMAIL_WEBHOOK_URL=
PROJEX_AUTH_EMAIL_WEBHOOK_BEARER_TOKEN=

# Local MinIO defaults from `compose.local.yaml`
S3_ENDPOINT=http://127.0.0.1:9010
S3_REGION=us-east-1
S3_BUCKET=projex-exports
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Optional local cross-origin dev setup
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Keep disabled unless you are explicitly testing dev-only flows
PROJEX_ENABLE_DEV_ENDPOINTS=false
PROJEX_ENABLE_SMOKE_TOOLS=false
VITE_ENABLE_SMOKE_TOOLS=false

# Auth bootstrap/link helpers
PROJEX_AUTH_EMAIL=
PROJEX_AUTH_PASSWORD=
PROJEX_AUTH_NAME=
PROJEX_BOOTSTRAP_COMPANY_NAME=Demo Company
PROJEX_BOOTSTRAP_PROJECT_NAME=Demo Project
# PROJEX_APP_TEMPLATE_USER_ID=
