{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "auth.ts",
        "src/router.tsx",
        "src/routes/**/*.{ts,tsx}",
        "scripts/run-release-migrations.mjs",
        "tests/browser/*.spec.ts",
        "deploy/nginx/maintenance.js"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "tests/**/*.{ts,tsx}",
        "scripts/**/*.{js,mjs,ts}"
      ],
      "ignoreDependencies": ["kysely-codegen"],
      "ignoreBinaries": ["cdk", "openssl"]
    },
    "deploy/cdk": {
      "entry": ["bin/projex-infra.ts"],
      "project": ["**/*.ts"],
      "ignoreDependencies": ["ts-node"]
    }
  }
}
