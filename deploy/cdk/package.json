{
  "name": "projex-cdk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm run typecheck:ts6",
    "synth": "cdk synth",
    "deploy": "cdk deploy",
    "diff": "cdk diff",
    "destroy": "cdk destroy",
    "typecheck:ts6": "tsc6 -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.266.0",
    "cdk-nag": "3.0.2",
    "constructs": "^10.8.1",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "@types/node": "^26.2.0",
    "aws-cdk": "^2.1136.0",
    "ts-node": "^10.9.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
