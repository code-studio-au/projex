{
  "app": "node --enable-source-maps --loader ts-node/esm bin/projex-infra.ts",
  "watch": {
    "include": ["bin/**/*.ts", "lib/**/*.ts"],
    "exclude": ["README.md", "cdk*.json", "package*.json", "tsconfig.json"]
  },
  "context": {
    "@aws-cdk/core:defaultCrossStackReferences": "strong",
    "envName": "staging",
    "githubRepository": "code-studio-au/projex",
    "instanceType": "t4g.small",
    "dbInstanceType": "t4g.micro",
    "dbAllocatedStorage": 20,
    "dbBackupRetentionDays": 1,
    "dbMultiAz": false,
    "dbName": "projex",
    "dbUsername": "projex_app",
    "sshCidr": ""
  }
}
