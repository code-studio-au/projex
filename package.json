{
  "name": "projex",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=24 <26",
    "pnpm": "11.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "coverage": "pnpm run coverage:selected-domain",
    "coverage:selected-domain": "node scripts/run-selected-domain-coverage.mjs",
    "test:integration:node": "node --import tsx --test tests/dbIntegration*.test.ts",
    "db:generate-types": "node --experimental-strip-types scripts/generate-db-types.ts",
    "db:verify-types": "node --experimental-strip-types scripts/generate-db-types.ts --verify",
    "profile:transaction-page": "node scripts/profile-transaction-page.mjs",
    "verify:security:repo": "node scripts/verify-repo-security.mjs",
    "verify:dead-code": "knip",
    "verify:security": "pnpm run verify:security:repo && pnpm audit --json && pnpm test && pnpm run typecheck && pnpm run lint",
    "verify:coverage": "pnpm run coverage",
    "verify:bundle": "node scripts/verify-client-bundle.mjs",
    "verify:app": "pnpm run verify:security:repo && pnpm audit --json && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run verify:dead-code && pnpm run verify:coverage && pnpm run build && pnpm run verify:bundle",
    "verify:db:gate": "pnpm run db:migrate && pnpm run db:verify-types && pnpm run test:integration:db",
    "verify:smoke:basics": "pnpm run smoke:server:disposable -- --section=basics",
    "verify:smoke:basics:skip-build": "pnpm run smoke:server:disposable -- --skip-build --section=basics",
    "verify:smoke:full": "pnpm run smoke:server:disposable",
    "verify:smoke:full:skip-build": "pnpm run smoke:server:disposable -- --skip-build",
    "verify:smoke:browser:basics": "pnpm run smoke:browser:disposable -- --section=basics",
    "verify:smoke:browser:basics:skip-build": "pnpm run smoke:browser:disposable -- --skip-build --section=basics",
    "verify:smoke:browser:full": "pnpm run smoke:browser:disposable",
    "verify:smoke:browser:full:skip-build": "pnpm run smoke:browser:disposable -- --skip-build",
    "verify:smoke:browser:firefox:full": "PROJEX_SMOKE_BROWSER=firefox pnpm run smoke:browser:disposable",
    "verify:smoke:browser:firefox:full:skip-build": "PROJEX_SMOKE_BROWSER=firefox pnpm run smoke:browser:disposable -- --skip-build",
    "verify:cdk": "pnpm exec vitest run deploy/cdk/tests && pnpm --dir deploy/cdk run build && pnpm run cdk:synth --quiet",
    "verify:ci": "pnpm run verify:app && pnpm run verify:static-analysis && pnpm run verify:cdk && pnpm run verify:db:gate && pnpm run verify:smoke:full:skip-build && pnpm run verify:smoke:browser:full:skip-build && pnpm run verify:smoke:browser:firefox:full:skip-build",
    "verify:precommit": "pnpm run db:migrate && pnpm run db:verify-types && pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run verify:dead-code && pnpm test && pnpm run build && pnpm run verify:bundle",
    "typecheck": "tsc -b --noemit",
    "lint": "node --max-old-space-size=4096 ./node_modules/eslint/bin/eslint.js .",
    "db:migrate": "node --experimental-strip-types src/server/db/migrate.ts",
    "auth:create-user": "node --experimental-strip-types src/server/auth/createAuthUser.ts",
    "auth:bootstrap-user": "node scripts/bootstrap-app-user.mjs",
    "auth:link-user": "node scripts/link-auth-user.mjs",
    "start:server": "node --import tsx scripts/start-server.mjs",
    "deploy:artifact:create": "bash scripts/create-deploy-artifact.sh",
    "smoke:server": "node scripts/smoke-server.mjs",
    "smoke:server:generated": "node scripts/smoke-server.mjs --use-generated-fixtures --sweep-stale-fixtures",
    "smoke:server:disposable": "node scripts/run-smoke-disposable.mjs",
    "smoke:browser": "node scripts/smoke-browser.mjs",
    "smoke:browser:disposable": "node scripts/run-smoke-disposable.mjs --browser",
    "smoke:cleanup": "node scripts/smoke-server.mjs --cleanup-stale-fixtures",
    "test:integration:db": "node scripts/run-db-integration.mjs",
    "verify:deploy-security": "node scripts/verify-deploy-security.mjs",
    "verify:shell": "node scripts/run-static-analysis.mjs shellcheck",
    "verify:actions": "node scripts/run-static-analysis.mjs actionlint",
    "verify:static-analysis": "pnpm run verify:shell && pnpm run verify:actions",
    "cdk:install": "pnpm --dir deploy/cdk install",
    "cdk:bootstrap": "pnpm --dir deploy/cdk exec cdk bootstrap",
    "cdk:synth": "pnpm --dir deploy/cdk exec cdk synth",
    "cdk:diff": "pnpm --dir deploy/cdk exec cdk diff",
    "cdk:deploy": "pnpm --dir deploy/cdk exec cdk deploy",
    "cdk:destroy": "pnpm --dir deploy/cdk exec cdk destroy",
    "preview": "vite preview",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "@mantine/core": "^9.3.0",
    "@mantine/dates": "^9.3.0",
    "@mantine/hooks": "^9.3.0",
    "@mantine/notifications": "9.3.0",
    "@tabler/icons-react": "^3.34.0",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-query-devtools": "^5.62.7",
    "@tanstack/react-router": "^1.170.8",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-start": "^1.168.13",
    "better-auth": "^1.6.22",
    "exceljs": "^4.4.0",
    "h3-v2": "npm:h3@2.0.1-rc.20",
    "kysely": "^0.29.2",
    "mantine-react-table-open": "^9.0.3",
    "pg": "^8.12.0",
    "pg-types": "^2.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "srvx": "^0.11.16",
    "tsx": "^4.22.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.61.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^24.11.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "29.1.1",
    "knip": "6.26.0",
    "kysely-codegen": "^0.20.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
