{
  "name": "projex",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "overrides": {
    "flatted": "^3.4.2",
    "minimatch": "^10.2.3",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.15",
    "yaml": "^1.10.3"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "db:generate-types": "node --experimental-strip-types scripts/generate-db-types.ts",
    "db:verify-types": "node --experimental-strip-types scripts/generate-db-types.ts --verify",
    "verify:security:repo": "node scripts/verify-repo-security.mjs",
    "verify:security": "pnpm run verify:security:repo && pnpm audit --json >/dev/null && pnpm test && pnpm run typecheck && pnpm run lint",
    "verify:ci": "pnpm run verify:security && pnpm run build && pnpm run test:integration:db && pnpm run smoke:server:disposable -- --skip-build --section=basics",
    "verify:precommit": "pnpm run db:migrate && pnpm run db:verify-types && pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm test && pnpm run build",
    "typecheck": "tsc -b --noemit",
    "lint": "eslint .",
    "db:migrate": "node --experimental-strip-types src/server/db/migrate.ts",
    "auth:create-user": "node --experimental-strip-types src/server/auth/createAuthUser.ts",
    "auth:bootstrap-user": "node scripts/bootstrap-app-user.mjs",
    "auth:link-user": "node scripts/link-auth-user.mjs",
    "start:server": "node --experimental-strip-types scripts/start-server.mjs",
    "deploy:ec2": "bash scripts/deploy-ec2.sh",
    "deploy:ec2:quick": "SKIP_INSTALL=true bash scripts/deploy-ec2.sh",
    "smoke:server": "node scripts/smoke-server.mjs",
    "smoke:server:generated": "node scripts/smoke-server.mjs --use-generated-fixtures --sweep-stale-fixtures",
    "smoke:server:disposable": "node scripts/run-smoke-disposable.mjs",
    "smoke:cleanup": "node scripts/smoke-server.mjs --cleanup-stale-fixtures",
    "test:integration:db": "node scripts/run-db-integration.mjs",
    "verify:deploy-security": "node scripts/verify-deploy-security.mjs",
    "cdk:install": "pnpm --dir deploy/cdk install",
    "cdk:bootstrap": "pnpm --dir deploy/cdk exec cdk -- bootstrap",
    "cdk:synth": "pnpm --dir deploy/cdk run synth",
    "cdk:diff": "pnpm --dir deploy/cdk run diff",
    "cdk:deploy": "pnpm --dir deploy/cdk run deploy",
    "cdk:destroy": "pnpm --dir deploy/cdk run destroy",
    "preview": "vite preview",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "@emotion/react": "^11.14.0",
    "@mantine/core": "^9.3.0",
    "@mantine/dates": "^9.3.0",
    "@mantine/hooks": "^9.3.0",
    "@mantine/notifications": "9.3.0",
    "@tabler/icons-react": "^3.34.0",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-query-devtools": "^5.62.7",
    "@tanstack/react-router": "^1.170.8",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-start": "^1.168.13",
    "better-auth": "^1.6.11",
    "exceljs": "^4.4.0",
    "h3-v2": "npm:h3@2.0.1-rc.20",
    "kysely": "^0.29.2",
    "mantine-react-table-open": "^9.0.3",
    "pg": "^8.12.0",
    "pg-types": "^2.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "srvx": "^0.11.16",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.11.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "kysely-codegen": "^0.20.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.3",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
